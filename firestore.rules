rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /teachers/{uid}/classes/{id} {
      allow read: if owner(uid);

      allow create: if owner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;

      allow update, delete: if false;
    }

    match /teachers/{uid}/students/{id} {
      allow read: if owner(uid);

      allow create: if owner(uid)
        && request.resource.data.id == id
        && request.resource.data.number is string
        && request.resource.data.name is string
        && request.resource.data.classId is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120;

      allow update, delete: if false;
    }

    match /teachers/{uid}/exams/{id} {
      allow read: if owner(uid);

      allow create: if owner(uid)
        && request.resource.data.title is string
        && request.resource.data.classId is string
        && request.resource.data.sections is list
        && request.resource.data.sections.size() >= 1
        && request.resource.data.sections.size() <= 5
        && request.resource.data.version == 1;

      allow update: if owner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'sections', 'version', 'updatedAt'
          ])
        && request.resource.data.sections is list
        && request.resource.data.sections.size() >= 1
        && request.resource.data.sections.size() <= 5
        && request.resource.data.version == resource.data.version + 1;

      allow delete: if false;

      match /keyHistory/{historyId} {
        allow read, create: if owner(uid);
        allow update, delete: if false;
      }
    }

    match /teachers/{uid}/results/{id} {
      allow read: if owner(uid);

      allow create: if owner(uid)
        && request.resource.data.examId is string
        && request.resource.data.studentId is string
        && request.resource.data.answers is list
        && request.resource.data.answers.size() >= 1
        && request.resource.data.answers.size() <= 50
        && request.resource.data.score is number
        && request.resource.data.maxScore is number
        && request.resource.data.maxScore > 0
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.maxScore
        && request.resource.data.createdAt == request.time;

      allow update: if owner(uid)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'score', 'maxScore', 'percentage', 'correct',
            'keyVersion', 'updatedAt'
          ])
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= request.resource.data.maxScore;

      allow delete: if false;

      match /history/{historyId} {
        allow read, create: if owner(uid);
        allow update, delete: if false;
      }
    }
  }
}